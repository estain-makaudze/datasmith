<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_zw_fdms" model="ir.ui.view">
        <field name="name">account.move.form.l10n.zw.fdms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="after">
                <page id="l10n_zw_fdms_tab" string="ZIMRA"
                      invisible="not l10n_zw_is_fiscalised">
                    <group>
                        <group string="Fiscalisation">
                            <field name="l10n_zw_fdms_state"/>
                            <field name="l10n_zw_receipt_global_no"/>
                            <field name="l10n_zw_fiscal_day_no"/>
                            <field name="l10n_zw_receipt_date"/>
                            <field name="l10n_zw_verification_code"/>
                            <field name="l10n_zw_validation_color"
                                   invisible="not l10n_zw_validation_color"/>
                        </group>
                        <group string="Verification">
                            <field name="l10n_zw_qr_data" widget="url"/>
                            <field name="l10n_zw_qr_image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <button name="action_l10n_zw_retry_send" type="object"
                            string="Retry ZIMRA Submission" class="btn-secondary"
                            invisible="l10n_zw_fdms_state == 'sent'"/>
                    <field name="l10n_zw_fdms_document_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_l10n_zw_fdms" model="ir.ui.view">
        <field name="name">account.move.list.l10n.zw.fdms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="l10n_zw_fdms_state" optional="hide" string="ZIMRA"/>
            </field>
        </field>
    </record>
</odoo>
