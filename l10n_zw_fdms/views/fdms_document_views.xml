<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fdms_document_view_list" model="ir.ui.view">
        <field name="name">l10n_zw.fdms.document.list</field>
        <field name="model">l10n_zw.fdms.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="receipt_global_no"/>
                <field name="document_type"/>
                <field name="invoice_no"/>
                <field name="move_id" optional="show"/>
                <field name="receipt_date"/>
                <field name="currency_code"/>
                <field name="receipt_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-info="state == 'signed'"
                       decoration-warning="state == 'ambiguous'"
                       decoration-danger="state == 'error'"/>
                <field name="validation_color" optional="show"
                       decoration-danger="validation_color == 'red'"
                       decoration-warning="validation_color in ('yellow', 'grey')"/>
                <field name="attempts" optional="hide"/>
                <field name="next_attempt_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="fdms_document_view_form" model="ir.ui.view">
        <field name="name">l10n_zw.fdms.document.form</field>
        <field name="model">l10n_zw.fdms.document</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_retry" type="object" string="Retry Submission"
                            invisible="state == 'sent'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Receipt">
                            <field name="device_id"/>
                            <field name="fiscal_day_id"/>
                            <field name="document_type"/>
                            <field name="move_id"/>
                            <field name="invoice_no"/>
                            <field name="receipt_global_no"/>
                            <field name="receipt_counter"/>
                            <field name="receipt_date"/>
                            <field name="currency_code"/>
                            <field name="receipt_total"/>
                            <field name="l10n_zw_original_document_id"
                                   invisible="document_type == 'FiscalInvoice'"/>
                        </group>
                        <group string="Signature &amp; Server">
                            <field name="verification_code"/>
                            <field name="qr_data" widget="url"/>
                            <field name="receipt_hash"/>
                            <field name="previous_hash"/>
                            <field name="receipt_id_zimra"/>
                            <field name="operation_id"/>
                            <field name="validation_color"/>
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <field name="errors" invisible="not errors"/>
                    <field name="validation_errors" widget="json" invisible="not validation_errors"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fdms_document_view_search" model="ir.ui.view">
        <field name="name">l10n_zw.fdms.document.search</field>
        <field name="model">l10n_zw.fdms.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_no"/>
                <field name="receipt_global_no"/>
                <filter string="To Send" name="to_send" domain="[('state', '=', 'signed')]"/>
                <filter string="Errors" name="errors" domain="[('state', 'in', ('error', 'ambiguous'))]"/>
                <filter string="Red Validation" name="red" domain="[('validation_color', '=', 'red')]"/>
                <group>
                    <filter string="Fiscal Day" name="by_day" domain="[]" context="{'group_by': 'fiscal_day_id'}"/>
                    <filter string="Status" name="by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="by_type" domain="[]" context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fdms_document_action" model="ir.actions.act_window">
        <field name="name">Fiscal Documents</field>
        <field name="res_model">l10n_zw.fdms.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fdms_document_view_search"/>
    </record>
</odoo>
