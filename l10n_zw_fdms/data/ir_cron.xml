<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_send_documents" model="ir.cron">
        <field name="name">ZIMRA FDMS: submit fiscal documents</field>
        <field name="model_id" ref="model_l10n_zw_fdms_document"/>
        <field name="state">code</field>
        <field name="code">model.trigger_next_batch()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_close_fiscal_days" model="ir.cron">
        <field name="name">ZIMRA FDMS: close aging fiscal days</field>
        <field name="model_id" ref="model_l10n_zw_fiscal_day"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_close()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_renew_certificates" model="ir.cron">
        <field name="name">ZIMRA FDMS: renew device certificates</field>
        <field name="model_id" ref="model_l10n_zw_fdms_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_renew_certificates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
