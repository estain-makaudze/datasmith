<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_freight_consignment" model="ir.sequence">
            <field name="name">Freight Consignment Reference Number</field>
            <field name="code">freight.consignment</field>
            <field name="prefix">CRN/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_freight_quote" model="ir.sequence">
            <field name="name">Freight Quote Number</field>
            <field name="code">freight.quote</field>
            <field name="prefix">QTE/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_freight_deposit" model="ir.sequence">
            <field name="name">Client Deposit Number</field>
            <field name="code">freight.deposit</field>
            <field name="prefix">DEP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_freight_boe" model="ir.sequence">
            <field name="name">Bill of Entry Reference</field>
            <field name="code">freight.boe</field>
            <field name="prefix">BOE/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_freight_trip" model="ir.sequence">
            <field name="name">Freight Trip Number</field>
            <field name="code">freight.trip</field>
            <field name="prefix">TRP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

    </data>
</odoo>
