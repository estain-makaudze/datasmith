<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="freight_transporter_view_list" model="ir.ui.view">
            <field name="name">res.partner.list.freight.transporter</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Transporters">
                    <field name="name"/>
                    <field name="freight_truck_regs"/>
                    <field name="freight_rate_per_km"/>
                    <field name="freight_flat_rate"/>
                    <field name="freight_currency_id" optional="hide"/>
                    <field name="phone" optional="show"/>
                </list>
            </field>
        </record>

        <record id="freight_transporter_view_search" model="ir.ui.view">
            <field name="name">res.partner.search.freight.transporter</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search string="Transporters">
                    <field name="name"/>
                    <field name="freight_truck_regs"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_freight_transporter" model="ir.actions.act_window">
            <field name="name">Transporters</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_freight_transporter', '=', True)]</field>
            <field name="context">{'default_is_freight_transporter': True, 'default_company_type': 'company'}</field>
            <field name="search_view_id" ref="freight_transporter_view_search"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('freight_transporter_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a sub-contracted transporter</p>
                <p>Truckers you hand jobs to. Trip rates default from here and payables
                   post against this partner once a POD is approved.</p>
            </field>
        </record>

    </data>
</odoo>
