<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="freight_client_view_form" model="ir.ui.view">
            <field name="name">res.partner.form.freight.client</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Freight" name="freight_client_page"
                          invisible="not is_freight_client and not is_freight_transporter">
                        <group>
                            <group string="Importer / Client">
                                <field name="is_freight_client"/>
                                <field name="freight_tin"
                                       invisible="not is_freight_client"/>
                                <field name="freight_bp_number"
                                       invisible="not is_freight_client"/>
                                <field name="freight_default_incoterm"
                                       invisible="not is_freight_client"/>
                            </group>
                            <group string="Transporter">
                                <field name="is_freight_transporter"/>
                                <field name="freight_truck_regs"
                                       invisible="not is_freight_transporter"/>
                                <field name="freight_currency_id"
                                       invisible="not is_freight_transporter"/>
                                <field name="freight_rate_per_km"
                                       invisible="not is_freight_transporter"/>
                                <field name="freight_flat_rate"
                                       invisible="not is_freight_transporter"/>
                            </group>
                        </group>
                        <group string="Client Notes"
                               invisible="not is_freight_client">
                            <field name="freight_notes" nolabel="1"/>
                        </group>
                        <group string="Transporter Notes"
                               invisible="not is_freight_transporter">
                            <field name="freight_notes_transporter" nolabel="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="freight_client_view_list" model="ir.ui.view">
            <field name="name">res.partner.list.freight.client</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Freight Clients">
                    <field name="name"/>
                    <field name="freight_tin"/>
                    <field name="freight_bp_number"/>
                    <field name="freight_default_incoterm" optional="show"/>
                    <field name="phone" optional="show"/>
                    <field name="email" optional="hide"/>
                    <field name="city" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="freight_client_view_search" model="ir.ui.view">
            <field name="name">res.partner.search.freight.client</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search string="Freight Clients">
                    <field name="name"/>
                    <field name="freight_tin"/>
                    <field name="freight_bp_number"/>
                    <field name="city"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_freight_client" model="ir.actions.act_window">
            <field name="name">Clients</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_freight_client', '=', True)]</field>
            <field name="context">{'default_is_freight_client': True, 'default_company_type': 'company'}</field>
            <field name="search_view_id" ref="freight_client_view_search"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('freight_client_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first importer</p>
                <p>Clients are importers you clear for. Their TIN and BP number appear on
                   the Bill of Entry and the fiscalised invoice.</p>
            </field>
        </record>

    </data>
</odoo>
