<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_groups_privilege_fuel" model="res.groups.privilege">
            <field name="name">Fuel Stations</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_fuel_attendant" model="res.groups">
            <field name="name">Attendant</field>
            <field name="sequence">10</field>
            <field name="comment">Captures readings and tender on their own shifts.</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_fuel_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">20</field>
            <field name="comment">Dips tanks, closes shifts and receives deliveries for their site.</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel"/>
            <field name="implied_ids" eval="[(4, ref('group_fuel_attendant'))]"/>
        </record>

        <record id="group_fuel_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">30</field>
            <field name="comment">Posts to Accounting, configures sites and sees every site.</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel"/>
            <field name="implied_ids" eval="[(4, ref('group_fuel_supervisor'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
