<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fuel_site_list" model="ir.ui.view">
            <field name="name">fuel.site.list</field>
            <field name="model">fuel.site</field>
            <field name="arch" type="xml">
                <list string="Sites">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="city"/>
                    <field name="manager_id"/>
                    <field name="tank_count" string="Tanks"/>
                    <field name="pump_count" string="Pumps"/>
                    <field name="tolerance_percent" string="Tolerance %"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_fuel_site_form" model="ir.ui.view">
            <field name="name">fuel.site.form</field>
            <field name="model">fuel.site</field>
            <field name="arch" type="xml">
                <form string="Site">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tanks" type="object" class="oe_stat_button" icon="fa-database">
                                <field name="tank_count" widget="statinfo" string="Tanks"/>
                            </button>
                            <button name="action_view_pumps" type="object" class="oe_stat_button" icon="fa-tachometer">
                                <field name="pump_count" widget="statinfo" string="Pumps"/>
                            </button>
                            <button name="action_view_nozzles" type="object" class="oe_stat_button" icon="fa-tint">
                                <field name="nozzle_count" widget="statinfo" string="Nozzles"/>
                            </button>
                            <button name="action_view_attendants" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="attendant_count" widget="statinfo" string="Attendants"/>
                            </button>
                        </div>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Msasa Service Station"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="MSA"/>
                                <field name="manager_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="street"/>
                                <field name="city"/>
                                <field name="phone"/>
                                <field name="tolerance_percent"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Tanks" name="tanks">
                                <field name="tank_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="product_id"
                                               context="{'default_is_fuel_grade': True, 'default_type': 'consu'}"
                                               options="{'no_quick_create': True}"/>
                                        <field name="capacity_litres"/>
                                        <field name="dead_stock_litres"/>
                                        <field name="chart_line_count" string="Chart rows"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Pumps" name="pumps">
                                <field name="pump_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="nozzle_count" string="Nozzles"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Current Prices" name="prices">
                                <field name="current_price_ids" readonly="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="price"/>
                                        <field name="valid_from"/>
                                        <field name="site_id" string="Set on"
                                               placeholder="All sites"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Attendants" name="attendants">
                                <field name="attendant_ids">
                                    <list editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="phone"/>
                                        <field name="is_supervisor"/>
                                        <field name="user_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_fuel_site_search" model="ir.ui.view">
            <field name="name">fuel.site.search</field>
            <field name="model">fuel.site</field>
            <field name="arch" type="xml">
                <search string="Sites">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="city"/>
                    <field name="manager_id"/>
                    <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                    <group>
                        <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                        <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_fuel_site" model="ir.actions.act_window">
            <field name="name">Sites</field>
            <field name="res_model">fuel.site</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Register your first station</p>
                <p>A site is one forecourt. Give it a short code, then add its tanks,
                   pumps, nozzles and attendants.</p>
            </field>
        </record>

    </data>
</odoo>
