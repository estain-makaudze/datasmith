<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_product_template_form_fuel" model="ir.ui.view">
            <field name="name">product.template.form.fuel</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="is_fuel_grade"/>
                </field>
            </field>
        </record>

        <record id="action_fuel_product" model="ir.actions.act_window">
            <field name="name">Fuel Grades</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_fuel_grade', '=', True)]</field>
            <field name="context">{'default_is_fuel_grade': True, 'default_type': 'consu'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define your grades</p>
                <p>Petrol, diesel, paraffin. Give each one the litre unit of measure.
                   Only grades listed here can be assigned to a tank.</p>
            </field>
        </record>

    </data>
</odoo>
