<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="payment_method_cash_usd" model="fuel.payment.method">
            <field name="name">Cash USD</field>
            <field name="code">cash_usd</field>
            <field name="kind">cash</field>
            <field name="sequence">10</field>
        </record>

        <record id="payment_method_cash_zig" model="fuel.payment.method">
            <field name="name">Cash ZiG</field>
            <field name="code">cash_zig</field>
            <field name="kind">cash</field>
            <field name="sequence">20</field>
        </record>

        <record id="payment_method_ecocash" model="fuel.payment.method">
            <field name="name">EcoCash</field>
            <field name="code">ecocash</field>
            <field name="kind">mobile</field>
            <field name="requires_reference" eval="True"/>
            <field name="sequence">30</field>
        </record>

        <record id="payment_method_swipe" model="fuel.payment.method">
            <field name="name">Swipe / Card</field>
            <field name="code">swipe</field>
            <field name="kind">card</field>
            <field name="requires_reference" eval="True"/>
            <field name="sequence">40</field>
        </record>

        <record id="payment_method_coupon" model="fuel.payment.method">
            <field name="name">Coupon</field>
            <field name="code">coupon</field>
            <field name="kind">coupon</field>
            <field name="sequence">50</field>
        </record>

        <record id="payment_method_docket" model="fuel.payment.method">
            <field name="name">Fleet Docket</field>
            <field name="code">docket</field>
            <field name="kind">docket</field>
            <field name="requires_reference" eval="True"/>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
