<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sage_sync_log_list" model="ir.ui.view">
        <field name="name">sage.sync.log.list</field>
        <field name="model">sage.sync.log</field>
        <field name="arch" type="xml">
            <list string="HTTP Log" decoration-success="success" decoration-danger="not success">
                <field name="started_at"/>
                <field name="config_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="duration_ms"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sage_sync_log_form" model="ir.ui.view">
        <field name="name">sage.sync.log.form</field>
        <field name="model">sage.sync.log</field>
        <field name="arch" type="xml">
            <form string="HTTP Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_ms"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="status_code"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_body" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Response">
                            <field name="response_body" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error" invisible="not error">
                            <field name="error" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sage_sync_log" model="ir.actions.act_window">
        <field name="name">HTTP Log</field>
        <field name="res_model">sage.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
