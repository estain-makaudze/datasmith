<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- `numbercall` was removed from ir.cron in Odoo 19 (crons now run forever
         by default). `active` is also inferred from the cron-is-enabled toggle
         and stays enabled unless explicitly set. -->
    <record id="cron_sage_sync_drain" model="ir.cron">
        <field name="name">Sage 300: drain sync queue</field>
        <field name="model_id" ref="model_sage_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_drain()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
