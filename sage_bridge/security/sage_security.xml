<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_sage_bridge" model="ir.module.category">
        <field name="name">Sage 300 Bridge</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_sage_user" model="res.groups">
        <field name="name">Sage 300: User</field>
        <field name="category_id" ref="module_category_sage_bridge"/>
        <field name="comment">Can push invoices to Sage and view sync logs.</field>
    </record>

    <record id="group_sage_manager" model="res.groups">
        <field name="name">Sage 300: Manager</field>
        <field name="category_id" ref="module_category_sage_bridge"/>
        <field name="implied_ids" eval="[(4, ref('group_sage_user'))]"/>
        <field name="comment">Can configure Sage connections and retry dead jobs.</field>
    </record>
</odoo>
