<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_l10n_zw" model="ir.ui.view">
        <field name="name">account.tax.form.l10n.zw</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="inside">
                <group name="l10n_zw" string="ZIMRA">
                    <field name="l10n_zw_tax_id"/>
                    <field name="l10n_zw_tax_code"/>
                    <field name="l10n_zw_is_exempt"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
