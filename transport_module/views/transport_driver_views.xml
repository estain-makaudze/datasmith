<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="transport_driver_view_list" model="ir.ui.view">
            <field name="name">transport.driver.list</field>
            <field name="model">transport.driver</field>
            <field name="arch" type="xml">
                <list decoration-muted="state == 'left'"
                      decoration-warning="state == 'suspended'">
                    <field name="name"/>
                    <field name="full_name"/>
                    <field name="driver_role"/>
                    <field name="phone" optional="show"/>
                    <field name="license_number" optional="show"/>
                    <field name="license_expiry" optional="hide"/>
                    <field name="payment_scheme_id"/>
                    <field name="default_vehicle_id"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-warning="state == 'suspended'"/>
                </list>
            </field>
        </record>

        <record id="transport_driver_view_form" model="ir.ui.view">
            <field name="name">transport.driver.form</field>
            <field name="model">transport.driver</field>
            <field name="arch" type="xml">
                <form string="Crew Member">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_cashups" type="object"
                                    class="oe_stat_button" icon="fa-money">
                                <field name="cashup_count" widget="statinfo"
                                       string="Cash-Ups"/>
                            </button>
                            <button name="action_view_leaves" type="object"
                                    class="oe_stat_button" icon="fa-plane">
                                <field name="leave_count" widget="statinfo"
                                       string="Leaves"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1><field name="full_name" placeholder="Crew member name"/></h1>
                            <h3><field name="name" readonly="1"/></h3>
                        </div>
                        <group>
                            <group string="Role &amp; Pay">
                                <field name="driver_role"/>
                                <field name="state"/>
                                <field name="payment_scheme_id"/>
                                <field name="default_vehicle_id"/>
                                <field name="hire_date"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Identification">
                                <field name="id_number"/>
                                <field name="license_number"/>
                                <field name="license_class"/>
                                <field name="license_expiry"/>
                                <field name="defensive_cert_expiry"/>
                            </group>
                            <group string="Contact">
                                <field name="phone"/>
                                <field name="address"/>
                                <field name="partner_id" groups="transport_module.group_transport_manager"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Leave Allocations" name="leave_allocations">
                                <field name="leave_allocation_ids">
                                    <list editable="bottom">
                                        <field name="leave_type_id"/>
                                        <field name="year"/>
                                        <field name="days_allocated"/>
                                        <field name="days_taken"/>
                                        <field name="days_remaining"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="transport_driver_view_kanban" model="ir.ui.view">
            <field name="name">transport.driver.kanban</field>
            <field name="model">transport.driver</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex">
                                <field name="image_128" widget="image"
                                       class="o_kanban_image me-2"/>
                                <div>
                                    <strong><field name="full_name"/></strong>
                                    <div><field name="driver_role"/></div>
                                    <div><field name="payment_scheme_id"/></div>
                                    <div><field name="default_vehicle_id"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_transport_driver" model="ir.actions.act_window">
            <field name="name">Drivers &amp; Conductors</field>
            <field name="res_model">transport.driver</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first crew member</p>
                <p>Drivers and conductors with licences, payment schemes,
                   leave allocations and their cash-up history.</p>
            </field>
        </record>

    </data>
</odoo>
