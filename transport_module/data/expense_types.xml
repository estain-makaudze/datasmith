<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="expense_type_fuel" model="transport.expense.type">
            <field name="name">Fuel</field>
            <field name="code">FUEL</field>
        </record>

        <record id="expense_type_tollgate" model="transport.expense.type">
            <field name="name">Tollgate</field>
            <field name="code">TOLL</field>
            <field name="requires_reference" eval="True"/>
        </record>

        <record id="expense_type_rank_fees" model="transport.expense.type">
            <field name="name">Rank Fees</field>
            <field name="code">RANK</field>
        </record>

        <record id="expense_type_police_fine" model="transport.expense.type">
            <field name="name">Police Fine</field>
            <field name="code">FINE</field>
            <field name="requires_reference" eval="True"/>
        </record>

        <record id="expense_type_car_wash" model="transport.expense.type">
            <field name="name">Car Wash</field>
            <field name="code">WASH</field>
        </record>

        <record id="expense_type_repairs" model="transport.expense.type">
            <field name="name">Minor Repairs</field>
            <field name="code">REP</field>
        </record>

        <record id="expense_type_service" model="transport.expense.type">
            <field name="name">Service &amp; Parts</field>
            <field name="code">SVC</field>
        </record>

        <record id="expense_type_labour" model="transport.expense.type">
            <field name="name">Workshop Labour</field>
            <field name="code">LAB</field>
        </record>

        <record id="expense_type_other" model="transport.expense.type">
            <field name="name">Other</field>
            <field name="code">OTH</field>
        </record>

    </data>
</odoo>
