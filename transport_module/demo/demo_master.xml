        <!-- Usual drivers on vehicles (after crew exists) -->
        <record id="vehicle_kombi_1" model="transport.vehicle">
            <field name="default_driver_id" ref="driver_tafadzwa"/>
        </record>
        <record id="vehicle_kombi_2" model="transport.vehicle">
            <field name="default_driver_id" ref="driver_blessing"/>
        </record>
        <record id="vehicle_kombi_3" model="transport.vehicle">
