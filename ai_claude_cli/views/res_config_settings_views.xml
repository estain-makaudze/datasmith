<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_claude" model="ir.ui.view">
        <field name="name">res.config.settings.ai.claude.cli</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add a third provider block alongside the native ChatGPT + Gemini
                 blocks, matching their visual pattern exactly. -->
            <xpath expr="//setting[@id='google_provider']" position="after">
                <setting id="claude_cli_provider"
                         string="Use your own Claude subscription"
                         help="Route Odoo AI through the local claude CLI (your Claude Code / Claude Max subscription) instead of an API key."
                         groups="base.group_system">
                    <field name="use_claude_cli"/>
                    <group invisible="not use_claude_cli">
                        <div class="flex-grow-1">
                            <label for="claude_cli_path" string="Path to claude binary"/>
                            <field name="claude_cli_path" placeholder="/usr/local/bin/claude" nolabel="1" class="w-100"/>
                            <label for="claude_cli_model" string="Model" class="mt8"/>
                            <field name="claude_cli_model" placeholder="sonnet" nolabel="1" class="w-100"/>
                            <label for="claude_cli_timeout" string="Timeout (seconds)" class="mt8"/>
                            <field name="claude_cli_timeout" nolabel="1"/>
                            <div class="mt8">
                                <button name="action_test_claude_cli" type="object"
                                        string="Test Claude connection"
                                        class="btn btn-secondary"/>
                            </div>
                        </div>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
