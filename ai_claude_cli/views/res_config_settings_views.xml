<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_claude" model="ir.ui.view">
        <field name="name">res.config.settings.ai.claude.cli</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Append a third provider block alongside ChatGPT / Gemini.
                 We add it at the end of the Providers section so it reads
                 as a natural third option. -->
            <xpath expr="//block[@id='ai_providers']" position="inside">
                <setting id="ai_provider_claude_cli"
                         string="Use your own Claude subscription"
                         help="Route Odoo AI through the local `claude` CLI (your Claude Code / Claude Max subscription) instead of an API key.">
                    <field name="use_claude_cli"/>
                    <div class="row mt16" invisible="not use_claude_cli">
                        <div class="col-12">
                            <label for="claude_cli_path" class="o_light_label"/>
                            <field name="claude_cli_path" placeholder="/usr/local/bin/claude"/>
                        </div>
                        <div class="col-6 mt8">
                            <label for="claude_cli_model" class="o_light_label"/>
                            <field name="claude_cli_model" placeholder="sonnet"/>
                        </div>
                        <div class="col-6 mt8">
                            <label for="claude_cli_timeout" class="o_light_label"/>
                            <field name="claude_cli_timeout"/>
                        </div>
                        <div class="col-12 mt8">
                            <button name="action_test_claude_cli" type="object"
                                    string="Test Claude connection"
                                    class="btn btn-secondary"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
